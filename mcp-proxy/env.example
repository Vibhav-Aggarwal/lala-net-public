# /etc/mcp-proxy/env  (chmod 0640, owner mcp:mcp)
# Space-separated list of filesystem paths the MCP server may read/write.
# Keep this list minimal — each path is exposed over HTTPS via Cloudflare Tunnel.

ALLOWED_DIRS="/home/vibhavaggarwal /var/www /opt /tmp"

# Optional: node label that appears in MCP resource URIs
MCP_NODE_LABEL="example-node"
